# AthenaX root .dockerignore — shared by BOTH image builds
# (apps/api/Dockerfile and apps/web/Dockerfile, context = repo root).
# Owner: agent C (infra-docs). See infrastructure/docker/README.md.

# VCS / CI
.git
.github
.gitignore

# Dependencies & build output (images install their own)
node_modules
**/node_modules
.next
**/.next
out
build
dist
**/__pycache__
**/*.pyc
**/*.pyo
.pytest_cache
.ruff_cache
.mypy_cache
*.egg-info
.venv
venv

# Python test/lint artifacts
coverage
**/coverage

# Env files — never bake secrets into images (compose/.env injection only)
.env
.env.*
!.env.example
!.env.production.example

# Local runtime data
storage
*.sqlite3

# Docs, research, monitoring (not needed inside images)
docs
research
infrastructure/monitoring
infrastructure/deployment
docker-compose.yml

# Editors / OS
.vscode
.idea
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-debug.log*
