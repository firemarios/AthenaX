{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://athenax.local/schemas/dataset.schema.json",
  "title": "Dataset",
  "description": "AthenaX dataset entity (matches the TS Dataset type).",
  "type": "object",
  "required": [
    "id",
    "title",
    "original_source",
    "tags",
    "quality",
    "provenance",
    "resources",
    "related_ids"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": ["string", "null"] },
    "provider": { "type": ["string", "null"] },
    "original_source": {
      "type": "object",
      "required": ["name", "url"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" }
      },
      "additionalProperties": false
    },
    "format": { "type": ["string", "null"] },
    "geographic_scope": { "type": ["string", "null"] },
    "category": { "type": ["string", "null"] },
    "license": { "type": ["string", "null"] },
    "last_updated": { "type": ["string", "null"] },
    "tags": { "type": "array", "items": { "type": "string" } },
    "quality": { "$ref": "#/definitions/quality" },
    "provenance": { "$ref": "#/definitions/provenance" },
    "resources": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "url", "format"],
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "format": { "type": "string" },
          "size_bytes": { "type": ["integer", "null"] }
        },
        "additionalProperties": false
      }
    },
    "related_ids": { "type": "array", "items": { "type": "string" } }
  },
  "additionalProperties": true,
  "definitions": {
    "quality": {
      "type": "object",
      "required": ["completeness", "freshness", "validity", "validation_status"],
      "properties": {
        "completeness": { "type": ["number", "null"] },
        "freshness": { "type": ["number", "null"] },
        "validity": { "type": ["number", "null"] },
        "validation_status": {
          "type": "string",
          "enum": ["pending", "valid", "invalid", "warning"]
        }
      },
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "required": ["source_version", "retrieved_at"],
      "properties": {
        "source_version": { "type": ["string", "null"] },
        "retrieved_at": { "type": ["string", "null"] },
        "checksum": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  }
}
