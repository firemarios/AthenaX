# --- Backend (apps/api) ---
ATHENAX_ENV=development
# Local dev default; use Postgres+PostGIS for full geospatial features.
ATHENAX_DATABASE_URL=sqlite+aiosqlite:///./storage/athenax.db
# ATHENAX_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/athenax
ATHENAX_API_BASE_URL=http://localhost:8000
ATHENAX_RATE_LIMIT_PER_MINUTE=120
ATHENAX_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# LLM provider: ollama | openai_compatible
ATHENAX_LLM_PROVIDER=ollama
ATHENAX_LLM_BASE_URL=http://localhost:11434
ATHENAX_LLM_API_KEY=
ATHENAX_LLM_MODEL=llama3.2
ATHENAX_LLM_VISION_MODEL=
ATHENAX_EMBEDDING_MODEL=nomic-embed-text

ATHENAX_DEFAULT_CITY=Athens
ATHENAX_MAX_AI_RECORDS=200
ATHENAX_UI_LOCALE_DEFAULT=el

# Optional object storage (S3/MinIO). Falls back to local ./storage when unset.
ATHENAX_S3_ENDPOINT_URL=
ATHENAX_S3_ACCESS_KEY=
ATHENAX_S3_SECRET_KEY=
ATHENAX_S3_BUCKET=athenax
ATHENAX_STORAGE_DIR=./storage

# Optional Redis for rate limiting / queues (falls back to in-memory).
ATHENAX_REDIS_URL=

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
