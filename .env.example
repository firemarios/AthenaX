# --- Backend (apps/api) ---
POLICYLAB_ENV=development
# Local dev default; use Postgres+PostGIS for full geospatial features.
POLICYLAB_DATABASE_URL=sqlite+aiosqlite:///./storage/policylab.db
# POLICYLAB_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/policylab
POLICYLAB_API_BASE_URL=http://localhost:8000
POLICYLAB_RATE_LIMIT_PER_MINUTE=120
POLICYLAB_CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# LLM provider: ollama | openai_compatible
POLICYLAB_LLM_PROVIDER=ollama
POLICYLAB_LLM_BASE_URL=http://localhost:11434
POLICYLAB_LLM_API_KEY=
POLICYLAB_LLM_MODEL=llama3.2
POLICYLAB_LLM_VISION_MODEL=
POLICYLAB_EMBEDDING_MODEL=nomic-embed-text

POLICYLAB_DEFAULT_CITY=Athens
POLICYLAB_MAX_AI_RECORDS=200
POLICYLAB_UI_LOCALE_DEFAULT=el

# Optional object storage (S3/MinIO). Falls back to local ./storage when unset.
POLICYLAB_S3_ENDPOINT_URL=
POLICYLAB_S3_ACCESS_KEY=
POLICYLAB_S3_SECRET_KEY=
POLICYLAB_S3_BUCKET=policylab
POLICYLAB_STORAGE_DIR=./storage

# Optional Redis for rate limiting / queues (falls back to in-memory).
POLICYLAB_REDIS_URL=

# --- Frontend (apps/web) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
